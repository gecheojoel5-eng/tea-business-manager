# Supabase Configuration
# Replace these with your project values from https://supabase.com -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Supabase Service Role Key (ONLY for backend migrations or administrative tasks, NEVER shared with browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
